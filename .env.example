# Azure Developer CLI environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control — wmsPassword and wmsUsername are secrets.

# ── azd required ──────────────────────────────────────────────────────────────
AZURE_ENV_NAME=dev
AZURE_LOCATION=southeastasia
AZURE_SUBSCRIPTION_ID=

# ── APIM configuration ────────────────────────────────────────────────────────
APIM_PUBLISHER_EMAIL=platform@contoso.com
APIM_PUBLISHER_NAME=BMWC Integration Platform
# Allowed IP CIDR list — JSON array string. Empty = allow all (demo).
# Production example: ["203.0.113.0/24","198.51.100.10/32"]
APIM_ALLOWED_IPS=[]
APIM_SAMPLING_PERCENTAGE=100
APIM_RATE_LIMIT_CALLS=100
APIM_RATE_LIMIT_PERIOD=60
APIM_QUOTA_CALLS=10000
APIM_QUOTA_PERIOD=604800
# After azd provision, copy from deployment output:
APIM_GATEWAY_URL=
APIM_SUBSCRIPTION_KEY=

# ── WMS configuration ─────────────────────────────────────────────────────────
# For local development: point at the mock
WMS_SOAP_ENDPOINT=http://localhost:8080/WMSService.svc
WMS_USERNAME=bmwc_api
# Never commit this value. Set via: azd env set WMS_PASSWORD <value>
WMS_PASSWORD=CHANGE-ME

# ── Service Bus ───────────────────────────────────────────────────────────────
SB_INBOUND_QUEUE_NAME=wms-inbound
SB_DLQ_QUEUE_NAME=wms-dead-letter-review
SB_MESSAGE_TTL=PT4H
SB_MAX_DELIVERY_COUNT=5
SB_LOCK_DURATION=PT10M

# ── Log Analytics ─────────────────────────────────────────────────────────────
LOG_RETENTION_DAYS=30
LOG_DAILY_QUOTA_GB=1

# ── Logic Apps plan ───────────────────────────────────────────────────────────
LA_MAX_ELASTIC_WORKERS=3

# ── Key Vault ─────────────────────────────────────────────────────────────────
KV_SOFT_DELETE_DAYS=7
KV_PURGE_PROTECTION=false

# ── azd output variables (auto-populated by post-provision.ps1) ───────────────
RESOURCE_GROUP_NAME=
LOGIC_APP_NAME=
APIM_NAME=
INBOUND_QUEUE_NAME=
APP_INSIGHTS_CONN_STR=
