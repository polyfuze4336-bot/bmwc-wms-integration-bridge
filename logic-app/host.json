{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle.Workflows",
    "version": "[1.*, 2.0.0)"
  },
  "extensions": {
    "workflow": {
      "settings": {
        "Runtime.FlowRetentionDays": "30",
        "Runtime.Backend.FlowRunTimeout": "P1D",

        "Runtime.ServiceProviders.ServiceBus.MessageSenderOperationTimeout": "00:01:00",

        "Workflows.bmwc-rest-ingress.FlowState":  "Enabled",
        "Workflows.wms-soap-dispatcher.FlowState": "Enabled",
        "Workflows.dlq-monitor.FlowState":          "Enabled",

        "Workflows.bmwc-rest-ingress.OperationOptions":  "",
        "Workflows.wms-soap-dispatcher.OperationOptions": "",
        "Workflows.dlq-monitor.OperationOptions":         ""
      }
    }
  },
  "logging": {
    "logLevel": {
      "default":        "Information",
      "Host.Results":   "Information",
      "Function":       "Information",
      "Host.Aggregator": "Trace"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 20,
        "excludedTypes": "Request"
      },
      "enableDependencyTracking": true,
      "enablePerformanceCountersCollection": false
    }
  }
}
