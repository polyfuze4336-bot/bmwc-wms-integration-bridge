      <wms:ResponseTimestamp>2026-04-10T02:00:01Z</wms:ResponseTimestamp>
    </wms:ResponseHeader>
  </soap:Header>

  <soap:Body>
    <wms:CreateOrderResponse>
      <wms:Status>SUCCESS</wms:Status>
      <wms:WmsOrderId>WMS-1744250401000-347</wms:WmsOrderId>
      <wms:Message>Order ORD-2026-SGP-001 accepted by WMS warehouse WH-SIN</wms:Message>
      <wms:EstimatedReadyDate>2026-04-11</wms:EstimatedReadyDate>
      <wms:WarehouseRef>WH-SIN-ORD-2026-SGP-001</wms:WarehouseRef>
    </wms:CreateOrderResponse>
